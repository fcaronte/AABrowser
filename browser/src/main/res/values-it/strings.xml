    <string name="perm_mic_desc">Utilizzato per la dettatura vocale e la ricerca nei siti web.</string>
    <string name="perm_location_title">Localizzazione di Rete</string>
    <string name="perm_location_desc">Usata per il meteo locale sullo schermo dell\'auto. I siti ricevono la posizione solo con l\'opzione qui sotto.</string>
    <string name="perm_notifications_title">Notifiche</string>
    <string name="perm_notifications_desc">Necessarie per il funzionamento del player musicale in background, il widget meteo e gli aggiornamenti.</string>
