    <!-- Onboarding / Welcome -->
    <string name="welcome_title">Benvenuto in CarWeb</string>
    <string name="welcome_subtitle">Il browser completo progettato per Android Auto. Per un\'esperienza ottimale, l\'app richiede alcuni permessi essenziali:</string>
