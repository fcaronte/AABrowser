<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: come backup_rules.xml, sia per il backup di Google sia per il passaggio a un nuovo telefono -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="ssl_exceptions.xml" />
        <exclude domain="sharedpref" path="iptv_sources.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="ssl_exceptions.xml" />
        <exclude domain="sharedpref" path="iptv_sources.xml" />
    </device-transfer>
</data-extraction-rules>
